          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Working title of the screenplay.",
          "minLength": 1,
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "description": "Editorial pipeline stage of the screenplay.",
          "enum": ["Under Review", "Pitch Deck Ready", "Archived"]
        },
        "genre": {
          "type": "string",
