        "authorUid",
        "title",
        "status",
        "genre",
        "format",
        "writer",
        "episodesOrRuntime",
        "year",
        "keyArt",
        "loglineSi",
        "loglineEn",
        "synopsisSi",
        "synopsisEn",
        "visualTone",
        "comparables",
        "targetModel",
        "views",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
