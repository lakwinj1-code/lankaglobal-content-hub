{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered member account profile with isolated PII accessible only to the account owner and platform administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Registered member display name.",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address (PII).",
          "minLength": 3,
          "maxLength": 160
        },
        "creatorType": {
          "type": "string",
          "description": "Community member persona selected at registration.",
          "enum": ["Screenwriter", "Producer", "Reader"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": ["uid", "displayName", "email", "creatorType", "createdAt", "updatedAt"]
    },
    "CreatorProfile": {
      "title": "CreatorProfile",
      "description": "Public filmmaker networking profile containing zero PII, displaying creative role, bio, follower counts, and collaboration availability.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public creator name.",
          "minLength": 2,
          "maxLength": 100
        },
        "creativeRole": {
          "type": "string",
          "description": "Primary filmmaking discipline.",
          "enum": [
            "Screenwriter",
            "Director",
            "Producer",
            "Cinematographer",
            "Actor",
            "Editor",
            "Composer",
            "Reader"
          ]
        },
        "headline": {
          "type": "string",
          "description": "Short professional headline displayed on profile cards.",
          "minLength": 0,
          "maxLength": 160
        },
        "bio": {
          "type": "string",
          "description": "Public biography, creative influences, and filmmaking focus.",
          "minLength": 0,
          "maxLength": 1000
        },
        "location": {
          "type": "string",
          "description": "City or region (non-PII).",
          "minLength": 0,
          "maxLength": 80
        },
        "openToCollab": {
          "type": "boolean",
          "description": "Whether the creator is open to co-production and filmmaking inquiries."
        },
        "followersCount": {
          "type": "integer",
          "description": "Total number of followers."
        },
        "followingCount": {
          "type": "integer",
          "description": "Total number of creators followed."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether this profile is listed in the public filmmaker directory."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "creativeRole",
        "headline",
        "bio",
        "location",
        "openToCollab",
        "followersCount",
        "followingCount",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreatorFollow": {
      "title": "CreatorFollow",
      "description": "Directional social follow edge between two registered creators.",
      "type": "object",
      "properties": {
        "followId": {
          "type": "string",
          "description": "Deterministic ID formatted as followerUid_followingUid.",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "followerUid": {
          "type": "string",
          "description": "UID of the follower.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "followingUid": {
          "type": "string",
          "description": "UID of the creator being followed.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "followerName": {
          "type": "string",
          "description": "Display name of the follower.",
          "minLength": 2,
          "maxLength": 100
        },
        "followingName": {
          "type": "string",
          "description": "Display name of the followed creator.",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when followed."
        }
      },
      "required": [
        "followId",
        "followerUid",
        "followingUid",
        "followerName",
        "followingName",
        "createdAt"
      ]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Public filmmaker community post for collaboration calls, script discussions, production updates, and industry insights.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Unique post ID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the post author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Public display name of the author.",
          "minLength": 2,
          "maxLength": 100
        },
        "authorRole": {
          "type": "string",
          "description": "Creative role of the author.",
          "enum": [
            "Screenwriter",
            "Director",
            "Producer",
            "Cinematographer",
            "Actor",
            "Editor",
            "Composer",
            "Reader"
          ]
        },
        "category": {
          "type": "string",
          "description": "Discussion category.",
          "enum": [
            "Collaboration Call",
            "Script Discussion",
            "Production Update",
            "Industry Insight"
          ]
        },
        "title": {
          "type": "string",
          "description": "Headline of the community post.",
          "minLength": 3,
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "description": "Main post content.",
          "minLength": 10,
          "maxLength": 2500
        },
        "linkedScriptId": {
          "type": "string",
          "description": "Optional publicScripts ID attached to the post.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedScriptTitle": {
          "type": "string",
          "description": "Optional title of the attached screenplay.",
          "minLength": 0,
          "maxLength": 140
        },
        "likesCount": {
          "type": "integer",
          "description": "Total applause/likes count."
        },
        "commentsCount": {
          "type": "integer",
          "description": "Total comments count."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the post is publicly visible."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of publication."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "postId",
        "authorUid",
        "authorName",
        "authorRole",
        "category",
        "title",
        "body",
        "linkedScriptId",
        "linkedScriptTitle",
        "likesCount",
        "commentsCount",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Individual member like/applause record under a CommunityPost.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Parent post ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Liking member UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when liked."
        }
      },
      "required": ["postId", "uid", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Member comment under a CommunityPost.",
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "description": "Unique comment ID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "postId": {
          "type": "string",
          "description": "Parent post ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Commenting member UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Public display name of commenter.",
          "minLength": 2,
          "maxLength": 100
        },
        "authorRole": {
          "type": "string",
          "description": "Creative role of commenter.",
          "enum": [
            "Screenwriter",
            "Director",
            "Producer",
            "Cinematographer",
            "Actor",
            "Editor",
            "Composer",
            "Reader"
          ]
        },
        "body": {
          "type": "string",
          "description": "Comment body text.",
          "minLength": 1,
          "maxLength": 800
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the comment is visible."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when commented."
        }
      },
      "required": [
        "commentId",
        "postId",
        "authorUid",
        "authorName",
        "authorRole",
        "body",
        "isPublished",
        "createdAt"
      ]
    },
    "CollabRequest": {
      "title": "CollabRequest",
      "description": "Private collaboration or screenplay option inquiry sent directly from one verified member to another creator.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Unique inquiry ID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "UID of the member initiating contact.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 2,
          "maxLength": 100
        },
        "senderRole": {
          "type": "string",
          "description": "Creative role of the sender.",
          "enum": [
            "Screenwriter",
            "Director",
            "Producer",
            "Cinematographer",
            "Actor",
            "Editor",
            "Composer",
            "Reader"
          ]
        },
        "recipientUid": {
          "type": "string",
          "description": "UID of the creator receiving the inquiry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientName": {
          "type": "string",
          "description": "Display name of the recipient.",
          "minLength": 2,
          "maxLength": 100
        },
        "scriptId": {
          "type": "string",
          "description": "Optional screenplay ID that prompted the inquiry.",
          "minLength": 0,
          "maxLength": 128
        },
        "scriptTitle": {
          "type": "string",
          "description": "Optional screenplay title.",
          "minLength": 0,
          "maxLength": 140
        },
        "purpose": {
          "type": "string",
          "description": "Reason for reaching out.",
          "enum": [
            "Story Option / Co-Production",
            "Directing / Production Team",
            "Script Feedback",
            "General Networking"
          ]
        },
        "message": {
          "type": "string",
          "description": "Collaboration proposal or inquiry message.",
          "minLength": 10,
          "maxLength": 1200
        },
        "senderContact": {
          "type": "string",
          "description": "Optional email or WhatsApp contact shared privately with recipient (PII).",
          "minLength": 0,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "description": "Current response state.",
          "enum": ["Pending", "Accepted", "Declined"]
        },
        "replyNote": {
          "type": "string",
          "description": "Recipient reply message and contact details.",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when sent."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "requestId",
        "senderUid",
        "senderName",
        "senderRole",
        "recipientUid",
        "recipientName",
        "scriptId",
        "scriptTitle",
        "purpose",
        "message",
        "senderContact",
        "status",
        "replyNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicScript": {
