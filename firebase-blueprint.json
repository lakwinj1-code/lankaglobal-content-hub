    "PrivateSubmission": {
      "title": "PrivateSubmission",
      "description": "Confidential NDA submission record containing writer PII, external cloud URL, and uploaded screenplay file metadata, accessible only to the submitting author and administrator.",
      "type": "object",
      "properties": {
        "scriptId": {
          "type": "string",
          "description": "Matching screenplay ID in publicScripts.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceId": {
          "type": "string",
          "description": "Mutual NDA reference code (e.g. LG-123456).",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Working title of the screenplay.",
          "minLength": 1,
          "maxLength": 140
        },
        "writerName": {
          "type": "string",
          "description": "Full legal or creator name.",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Writer contact email address (PII).",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Writer phone or WhatsApp number (PII).",
          "minLength": 7,
          "maxLength": 40
        },
        "genre": {
          "type": "string",
          "description": "Primary genre.",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "type": "string",
          "description": "Production format.",
          "minLength": 1,
          "maxLength": 80
        },
        "logline": {
          "type": "string",
          "description": "Submitted logline.",
          "minLength": 20,
          "maxLength": 1000
        },
        "scriptUrl": {
          "type": "string",
          "description": "Optional Google Drive or Dropbox screenplay link.",
          "minLength": 0,
          "maxLength": 500
        },
        "fileName": {
          "type": "string",
          "description": "Original filename of the uploaded screenplay document.",
          "minLength": 0,
          "maxLength": 200
        },
        "fileMimeType": {
          "type": "string",
          "description": "MIME type of the uploaded screenplay document.",
          "minLength": 0,
          "maxLength": 120
        },
        "fileSizeBytes": {
          "type": "integer",
          "description": "Byte size of the uploaded screenplay file."
        },
        "chunkCount": {
          "type": "integer",
          "description": "Total number of Base64 chunks stored in the fileChunks subcollection."
        },
        "ipConfirmed": {
          "type": "boolean",
          "description": "Creator confirmation of 100% IP ownership and NDA acceptance."
        },
        "reviewStatus": {
          "type": "string",
          "description": "Editorial review status managed by the administrator.",
          "enum": ["Pending Review", "Shortlisted", "Pitch Deck Ready", "Archived"]
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal editorial coverage notes written by the administrator.",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest review update."
        }
      },
      "required": [
        "scriptId",
        "authorUid",
        "referenceId",
        "title",
        "writerName",
        "email",
        "phone",
        "genre",
        "format",
        "logline",
        "scriptUrl",
        "fileName",
        "fileMimeType",
        "fileSizeBytes",
        "chunkCount",
        "ipConfirmed",
        "reviewStatus",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "FileChunk": {
      "title": "FileChunk",
      "description": "Chunked Base64 binary segment of an uploaded screenplay file stored under a PrivateSubmission.",
      "type": "object",
      "properties": {
        "scriptId": {
          "type": "string",
          "description": "Parent submission ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkId": {
          "type": "string",
          "description": "Chunk document ID (e.g. chunk_0).",
          "minLength": 7,
          "maxLength": 12,
          "pattern": "^chunk_[0-9]{1,2}$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the uploading creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkIndex": {
          "type": "integer",
          "description": "Zero-based sequential chunk index."
        },
        "dataBase64": {
          "type": "string",
          "description": "Base64-encoded file segment (up to 650,000 characters).",
          "minLength": 1,
          "maxLength": 650000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when chunk was uploaded."
        }
      },
      "required": [
        "scriptId",
        "chunkId",
        "authorUid",
        "chunkIndex",
        "dataBase64",
        "createdAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin entry was created."
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Registered member account profiles isolated per user UID."
