    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Language State Management
        let currentLang = 'si'; // Default Sinhala

        const langToggleBtn = document.getElementById('langToggle');
        const currentLangText = document.getElementById('currentLangText');

        langToggleBtn.addEventListener('click', () => {
            currentLang = currentLang === 'si' ? 'en' : 'si';
            currentLangText.textContent = currentLang === 'si' ? 'SI / EN' : 'EN / SI';
            
            // Translate all elements with data-lang attributes
            document.querySelectorAll('[data-lang-en]').forEach(el => {
                if (currentLang === 'en') {
                    el.textContent = el.getAttribute('data-lang-en');
                } else {
                    el.textContent = el.getAttribute('data-lang-si');
                }
            });
        });

        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Filter Buttons Logic for Pipeline Showcase
        const filterBtns = document.querySelectorAll('.filter-btn');
        const projectCards = document.querySelectorAll('#pipelineGrid > div');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'bg-brand-cyan', 'text-slate-950');
                    b.classList.add('glass-panel', 'text-slate-300');
                });
                btn.classList.add('active', 'bg-brand-cyan', 'text-slate-950');
                btn.classList.remove('glass-panel', 'text-slate-300');

                const category = btn.getAttribute('data-category');

                projectCards.forEach(card => {
                    if (category === 'all' || card.getAttribute('data-status') === category) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Pitch Builder Live Interactive Updates
        const demoTitle = document.getElementById('demoTitle');
        const demoGenre = document.getElementById('demoGenre');
        const demoFormat = document.getElementById('demoFormat');
        const demoLogline = document.getElementById('demoLogline');
        const demoTone = document.getElementById('demoTone');

        const previewTitle = document.getElementById('previewTitle');
        const previewGenre = document.getElementById('previewGenre');
        const previewFormat = document.getElementById('previewFormat');
        const previewLogline = document.getElementById('previewLogline');
        const previewTone = document.getElementById('previewTone');

        demoTitle.addEventListener('input', (e) => previewTitle.textContent = e.target.value || 'TITLE');
        demoGenre.addEventListener('change', (e) => previewGenre.textContent = e.target.value);
        demoFormat.addEventListener('change', (e) => previewFormat.textContent = e.target.value.toUpperCase());
        demoLogline.addEventListener('input', (e) => previewLogline.textContent = `"${e.target.value}"`);
        demoTone.addEventListener('change', (e) => previewTone.textContent = e.target.value);

        // Script Submission Form Handler
        const scriptForm = document.getElementById('scriptSubmissionForm');
        const successModal = document.getElementById('successModal');

        scriptForm.addEventListener('submit', (e) => {
            e.preventDefault();
            successModal.classList.remove('hidden');
            scriptForm.reset();
        });

        function closeModal() {
            successModal.classList.add('hidden');
        }
    </script>
